# Configuración del Servidor Fastify
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=super_secret_asm_jwt_key_2026_dev_mode_change_in_production
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asm_db"

# Configuración de Envío de Correos Reales (SMTP)
# Puedes usar cualquier proveedor SMTP estándar (Gmail con Contraseña de Aplicación, Brevo, SendGrid, Resend, etc.)
# Si dejas estos campos vacíos, el sistema genera automáticamente un enlace de previsualización real con Ethereal Email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Avante School Management" <soporte@avanteschoolmanagement.com>
